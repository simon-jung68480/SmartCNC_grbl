{
  "name": "smart-cnc",
  "version": "0.1.0",
  "description": "Interface de commande CNC moderne pour Arduino Uno + CNC Shield V3.0 (GRBL 1.1)",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "node --import tsx server/index.ts",
    "build": "vite build",
    "start": "node --import tsx server/index.ts",
    "preview": "vite preview",
    "build:desktop": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server/index.mjs",
    "desktop": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win nsis"
  },
  "build": {
    "appId": "fr.smartcnc.desktop",
    "productName": "SmartCNC",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "build/server/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "SmartCNC-Setup-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "clipper-lib": "^6.4.2",
    "color-string": "^2.1.4",
    "cors": "^2.8.5",
    "dxf-parser": "^1.1.2",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "svgpath": "^2.6.0",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@types/clipper-lib": "^6.4.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.9.12",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
